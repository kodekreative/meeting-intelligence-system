# =============================================================================
# Meeting Intelligence System - Environment Variables
# =============================================================================

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# Airtable Configuration
# -----------------------------------------------------------------------------
AIRTABLE_API_KEY=your_airtable_api_key_here
AIRTABLE_BASE_ID=your_airtable_base_id_here

# Table IDs (optional if using table names)
AIRTABLE_MEETINGS_TABLE=Meetings
AIRTABLE_COMPANIES_TABLE=Companies
AIRTABLE_CONTACTS_TABLE=Contacts
AIRTABLE_ACTION_ITEMS_TABLE=Action Items
AIRTABLE_PERSONAL_INTELLIGENCE_TABLE=Personal Intelligence
AIRTABLE_BUSINESS_ISSUES_TABLE=Business Issues

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS_ENABLED=false

# Redis connection URL (alternative to individual settings)
# REDIS_URL=redis://localhost:6379

# Cache TTL in seconds
REDIS_CACHE_TTL=300

# -----------------------------------------------------------------------------
# Microsoft Graph / Azure AD Configuration
# -----------------------------------------------------------------------------
MICROSOFT_CLIENT_ID=your_azure_ad_client_id_here
MICROSOFT_CLIENT_SECRET=your_azure_ad_client_secret_here
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:3001/auth/callback

# Microsoft Graph API scopes
MICROSOFT_SCOPES=Calendars.Read,Mail.Send,offline_access

# -----------------------------------------------------------------------------
# OpenAI Configuration
# -----------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=4000
OPENAI_TEMPERATURE=0.2

# OpenAI rate limits and retry configuration
OPENAI_MAX_RETRIES=3
OPENAI_TIMEOUT=60000

# -----------------------------------------------------------------------------
# JWT Configuration
# -----------------------------------------------------------------------------
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_change_this
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Email Configuration
# -----------------------------------------------------------------------------
EMAIL_FROM_ADDRESS=noreply@pinelakecapital.com
EMAIL_FROM_NAME=Meeting Intelligence System

# Daily email delivery time (24-hour format)
DAILY_EMAIL_HOUR=6
DAILY_EMAIL_MINUTE=0

# Default timezone for email delivery
DEFAULT_TIMEZONE=America/New_York

# -----------------------------------------------------------------------------
# AI Processing Configuration
# -----------------------------------------------------------------------------
AI_CONFIDENCE_THRESHOLD=0.7
AI_PROCESSING_CONCURRENCY=3

# Default due date for action items (days from meeting)
ACTION_ITEM_DEFAULT_DUE_DAYS=5

# Follow-up thresholds
FOLLOW_UP_IN_PROGRESS_DAYS=7
FOLLOW_UP_APPROACHING_DUE_DAYS=2

# -----------------------------------------------------------------------------
# Read.ai Integration (Optional)
# -----------------------------------------------------------------------------
READ_AI_API_KEY=your_read_ai_api_key_if_available
READ_AI_WEBHOOK_SECRET=your_read_ai_webhook_secret

# -----------------------------------------------------------------------------
# Frontend Configuration (Next.js)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=Meeting Intelligence System
NEXT_PUBLIC_APP_ENV=development

# -----------------------------------------------------------------------------
# Monitoring & Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=info
SENTRY_DSN=

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Encryption key for sensitive data (32 characters minimum)
ENCRYPTION_KEY=your_32_char_encryption_key_here_change_in_prod

# -----------------------------------------------------------------------------
# Bull Queue Configuration
# -----------------------------------------------------------------------------
BULL_REDIS_HOST=localhost
BULL_REDIS_PORT=6379
BULL_REDIS_PASSWORD=

# Queue job concurrency
QUEUE_CONCURRENCY_AI=2
QUEUE_CONCURRENCY_EMAIL=5

# -----------------------------------------------------------------------------
# Development/Testing
# -----------------------------------------------------------------------------
ENABLE_API_DOCS=true
MOCK_EXTERNAL_APIS=false
SKIP_EMAIL_SENDING=false
